{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git revert:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh run watch:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(npm run dev:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Edit(.github/**)",
      "Write(.github/**)",
      "Edit(package.json)",
      "Write(package.json)",
      "Edit(package-lock.json)",
      "Write(package-lock.json)",
      "Edit(vite.config.js)",
      "Write(vite.config.js)",
      "Edit(tsconfig.json)",
      "Write(tsconfig.json)",
      "Edit(tailwind.config.js)",
      "Write(tailwind.config.js)",
      "Edit(postcss.config.js)",
      "Write(postcss.config.js)",
      "Edit(public/CNAME)",
      "Write(public/CNAME)",
      "Edit(src/config/configuration.js)",
      "Write(src/config/configuration.js)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)"
    ]
  }
}
